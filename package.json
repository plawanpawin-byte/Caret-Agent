{
  "name": "caret-agent",
  "productName": "Caret Agent",
  "version": "0.3.1",
  "description": "A free AI IDE that remembers your work across every model — Claude, Codex, Grok, Gemini and the local models already on your machine.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.caretagent.desktop",
    "productName": "Caret Agent",
    "directories": { "output": "dist" },
    "files": [
      "src/**/*",
      "resources/**/*",
      "node_modules/monaco-editor/min/**/*",
      "package.json"
    ],
    "extraResources": [{ "from": "resources", "to": "resources" }],
    "win": { "target": "nsis", "icon": "resources/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
